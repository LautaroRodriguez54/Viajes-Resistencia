# Opcional: copiar a .env.local (Git lo ignora). Sin este archivo la web funciona con los valores por defecto.

# URL del backend (por defecto http://localhost:3000).
# VITE_API_URL=http://localhost:3000

# Mapa: por defecto es el real (Leaflet + OpenStreetMap, sin clave ni cuenta) con búsqueda de direcciones
# (Photon). "simulado" fuerza el dibujo y la lista fija de lugares: sin internet, E2E o CI.
# VITE_MAPA=simulado
