NODE_ENV=development
PORT=3000
# Una base y un rol por módulo (tema 12, ADR 008). `npm run setup` crea las bases y los roles.
# Son credenciales de desarrollo; en producción van otras, fuera del repo.
DATABASE_URL=postgres://viajes_app:viajes_app_dev@localhost:5433/viajes
BILLETERA_DATABASE_URL=postgres://billetera_app:billetera_app_dev@localhost:5433/billetera
LECTURA_DATABASE_URL=postgres://lectura_app:lectura_app_dev@localhost:5433/lectura
# Superusuario del contenedor: sólo lo usa `npm run migrate` (bases, roles, extensiones y tablas).
ADMIN_DATABASE_URL=postgres://viajes:viajes@localhost:5433/postgres
DATABASE_SSL=false
# Timeouts de los pools (ms). Si no se definen, valen 5000, 30000 y 15000.
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Cada cuánto el backend procesa los outbox (billetera nueva, proyección de saldos).
OUTBOX_INTERVALO_MS=500
JWT_SECRET=cambiar-por-un-secreto-de-desarrollo-de-al-menos-32-caracteres
JWT_ACCESS_TOKEN_TTL=15m
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
WEBHOOK_HMAC_SECRET=cambiar-por-un-secreto-de-webhook-de-al-menos-32-caracteres
# Carga de saldo desde la web con la pasarela simulada (demo). Vacío: activa salvo con NODE_ENV=production.
PASARELA_SIMULADA_HABILITADA=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
RATE_LIMIT_LOGIN_VENTANA_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_WEBHOOK_VENTANA_MS=60000
RATE_LIMIT_WEBHOOK_MAX=60
RATE_LIMIT_UBICACION_VENTANA_MS=60000
RATE_LIMIT_UBICACION_MAX=60

IDEMPOTENCIA_TTL_SEGUNDOS=86400
OFERTA_TTL_SEGUNDOS=30
OFERTA_VERIFICACION_MS=1000
# Exige que la última ubicación reportada del chofer tenga menos de N segundos (evita choferes fantasma en demos).
UBICACION_TTL_SEGUNDOS=60
# Batching asíncrono de historial_ubicaciones_chofer (ADR 005).
HISTORIAL_UBICACIONES_FLUSH_MS=1000
HISTORIAL_UBICACIONES_LOTE_MAX=250
HISTORIAL_UBICACIONES_BUFFER_MAX=10000
